# Copy this to .env.local for local development only (NEVER commit .env.local!)
# In GitHub Pages deployment, these are automatically injected from:
# Repository Settings -> Secrets and variables -> Actions

# SHA-256 hash of your dashboard passcode (auto-computed in GitHub Actions from secrets.DASHBOARD_PASSCODE)
VITE_PASSCODE_HASH=

# Google Cloud OAuth 2.0 Web Client ID (from vars.GOOGLE_CLIENT_ID or secrets.GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Root AI-Brain Folder ID in Google Drive
VITE_DRIVE_ROOT_FOLDER_ID=1xbgHAgoAoJIWEoERxdXILgC6N861F8h6

# Core BOOTSTRAP.md File ID for quick copy in Arena new chats
VITE_BOOTSTRAP_FILE_ID=1qDVWA6wN55JfrHleKbb9Zd06jFqf8u2x
